# ══════════════════════════════════════════════════════════════
#  .env.example — Template Environment Variables untuk ZTYLE
#  Salin file ini ke .env (untuk development) atau isi di
#  Vercel Dashboard → Project → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# ─── DATABASE (Neon PostgreSQL) ───────────────────────────────
# Dapatkan dari: https://neon.tech → Project → Connection String
# Gunakan connection string dengan sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── JWT AUTH ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=your-very-long-random-secret-here

# ─── URL KONFIGURASI ─────────────────────────────────────────
# URL frontend production (tidak ada trailing slash)
FRONTEND_URL=https://ztyle.vercel.app

# ─── NODEMAILER SMTP ─────────────────────────────────────────
# Untuk Gmail: gunakan App Password (bukan password akun)
# Enable: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ─── MIDTRANS PAYMENT GATEWAY ────────────────────────────────
# Daftar di: https://dashboard.midtrans.com
# SANDBOX (development/testing) — prefix SB-:
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXX
# PRODUCTION (live) — tanpa prefix SB-:
# MIDTRANS_SERVER_KEY=Mid-server-XXXX
# MIDTRANS_CLIENT_KEY=Mid-client-XXXX

# ─── VERCEL BLOB (upload gambar) ─────────────────────────────
# Otomatis tersedia jika Vercel Blob sudah di-setup di project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXX

# ─── ENVIRONMENT ─────────────────────────────────────────────
NODE_ENV=production
